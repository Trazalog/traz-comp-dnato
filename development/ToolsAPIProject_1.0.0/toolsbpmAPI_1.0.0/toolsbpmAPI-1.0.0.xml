   <resource methods="POST" uri-template="/actor/rol">
      <inSequence>
         <log level="custom" description="msg entrada agregar rol a actor">
            <property name="nombre_proceso" expression="json-eval($.nombre_proceso)"/>
            <property name="nombre_actor" expression="json-eval($.nombre_actor)"/>
            <property name="nombre_rol" expression="json-eval($.nombre_rol)"/>
            <property name="session" expression="json-eval($.session)"/>
         </log>
         <property name="nombre_proceso" expression="json-eval($.nombre_proceso)"/>
         <property name="nombre_actor" expression="json-eval($.nombre_actor)"/>
         <property name="nombre_rol" expression="json-eval($.nombre_rol)"/>
         <property name="session" expression="json-eval($.session)"/>
         <header name="Accept" scope="transport" value="application/json"/>
         <property name="getprocess_url" expression="fn:concat('/API/bpm/process?p=0&amp;c=10&amp;s=',$ctx:nombre_proceso,'&amp;f=activationState%3DENABLED')" scope="default" type="STRING"/>
         <log level="custom" category="DEBUG">
            <property name="url get process" expression="get-property('getprocess_url')"/>
         </log>
         <call-template target="bpmAPICallTemplate">
            <with-param name="recurso" value="{$ctx:getprocess_url}"/>
            <with-param name="session" value="{$ctx:session}"/>
            <with-param name="method" value="GET"/>
         </call-template>
         <property name="session" expression="json-eval($.session)"/>
         <script language="js"><![CDATA[
            try {
               var payload = mc.getPayloadJSON();
               var procs = payload && payload.payload;
               var procId = null;
               if (Array.isArray(procs) && procs.length > 0) {
                  procId = procs[0].id || procs[0].processId;
               } else if (procs && (procs.id || procs.processId)) {
                  procId = procs.id || procs.processId;
               }
               if (!procId) {
                  mc.setProperty('TOOLS_ERROR', 'Proceso no encontrado: ' + mc.getProperty('nombre_proceso'));
                  mc.setProperty('ERROR_MESSAGE', 'No existe proceso con ese nombre o no está habilitado');
               } else {
                  mc.setProperty('bpmProcessId', String(procId));
               }
            } catch (e) {
               mc.setProperty('TOOLS_ERROR', 'Error al obtener proceso');
               mc.setProperty('ERROR_MESSAGE', e.toString());
            }
         ]]></script>
         <filter regex="true" source="boolean(get-property('bpmProcessId'))">
            <then>
               <property name="getactors_url" expression="fn:concat('/API/bpm/actor?p=0&amp;c=100&amp;f=process_id%3D',$ctx:bpmProcessId)" scope="default" type="STRING"/>
               <log level="custom" category="DEBUG">
                  <property name="url get actors" expression="get-property('getactors_url')"/>
               </log>
               <call-template target="bpmAPICallTemplate">
                  <with-param name="recurso" value="{$ctx:getactors_url}"/>
                  <with-param name="session" value="{$ctx:session}"/>
                  <with-param name="method" value="GET"/>
               </call-template>
               <property name="session" expression="json-eval($.session)"/>
               <script language="js"><![CDATA[
                  try {
                     var payload = mc.getPayloadJSON();
                     var actors = payload.payload;
                     var nombreActor = mc.getProperty('nombre_actor');
                     if (!actors || actors.length === 0) {
                        mc.setProperty('TOOLS_ERROR', 'No se encontraron actores en el proceso');
                        mc.setProperty('ERROR_MESSAGE', '');
                     } else {
                        var found = false;
                        for (var i = 0; i < actors.length; i++) {
                           if (actors[i].name === nombreActor) {
                              mc.setProperty('actorId', String(actors[i].id));
                              found = true;
                              break;
                           }
                        }
                        if (!found) {
                           mc.setProperty('TOOLS_ERROR', 'Actor no encontrado: ' + nombreActor);
                           mc.setProperty('ERROR_MESSAGE', 'Verifique el nombre del actor en el proceso');
                        }
                     }
                  } catch (e) {
                     mc.setProperty('TOOLS_ERROR', 'Error al obtener actores');
                     mc.setProperty('ERROR_MESSAGE', e.toString());
                  }
               ]]></script>
            </then>
            <else>
               <sequence key="toolsFault"/>
            </else>
         </filter>
         <filter regex="true" source="boolean(get-property('actorId'))">
            <then>
               <property name="getroles_url" expression="fn:concat('/API/identity/role?p=0&amp;c=1000&amp;s=',$ctx:nombre_rol)" scope="default" type="STRING"/>
               <log level="custom" category="DEBUG">
                  <property name="url get roles" expression="get-property('getroles_url')"/>
               </log>
               <call-template target="bpmAPICallTemplate">
                  <with-param name="recurso" value="{$ctx:getroles_url}"/>
                  <with-param name="session" value="{$ctx:session}"/>
                  <with-param name="method" value="GET"/>
               </call-template>
               <property name="session" expression="json-eval($.session)"/>
               <script language="js"><![CDATA[
                  try {
                     var payload = mc.getPayloadJSON();
                     var roles = payload.payload;
                     var nombreRol = mc.getProperty('nombre_rol');
                     if (!roles || roles.length === 0) {
                        mc.setProperty('TOOLS_ERROR', 'Rol no encontrado: ' + nombreRol);
                        mc.setProperty('ERROR_MESSAGE', '');
                     } else {
                        var found = false;
                        for (var i = 0; i < roles.length; i++) {
                           if (roles[i].name === nombreRol) {
                              mc.setProperty('roleId', String(roles[i].id));
                              found = true;
                              break;
                           }
                        }
                        if (!found) {
                           mc.setProperty('TOOLS_ERROR', 'Rol no encontrado: ' + nombreRol);
                           mc.setProperty('ERROR_MESSAGE', 'Verifique el nombre del rol');
                        }
                     }
                  } catch (e) {
                     mc.setProperty('TOOLS_ERROR', 'Error al obtener roles');
                     mc.setProperty('ERROR_MESSAGE', e.toString());
                  }
               ]]></script>
            </then>
            <else>
               <sequence key="toolsFault"/>
            </else>
         </filter>
         <filter regex="true" source="boolean(get-property('roleId'))">
            <then>
               <payloadFactory media-type="json" description="payload actorMember">
                  <format>{"actor_id":"$1","role_id":"$2","group_id":"-1","user_id":"-1"}</format>
                  <args>
                     <arg evaluator="xml" expression="get-property('actorId')"/>
                     <arg evaluator="xml" expression="get-property('roleId')"/>
                  </args>
               </payloadFactory>
               <script language="js"><![CDATA[
                  var pl = mc.getPayloadJSON();
                  mc.setProperty('actorMemberPayload', JSON.stringify(pl));
               ]]></script>
               <property name="post_actormember_url" value="/API/bpm/actorMember" scope="default" type="STRING"/>
               <log level="custom" category="DEBUG">
                  <property name="url post actorMember" expression="get-property('post_actormember_url')"/>
               </log>
               <call-template target="bpmAPICallTemplate">
                  <with-param name="recurso" value="{$ctx:post_actormember_url}"/>
                  <with-param name="session" value="{$ctx:session}"/>
                  <with-param name="payload" value="{$ctx:actorMemberPayload}"/>
                  <with-param name="method" value="POST"/>
               </call-template>
               <property name="session" expression="json-eval($.session)"/>
               <respond/>
            </then>
            <else>
               <sequence key="toolsFault"/>
            </else>
         </filter>
      </inSequence>
      <outSequence>
         <log level="full">
            <property name="MESSAGE" value="FIRST"/>
         </log>
         <send/>
      </outSequence>
      <faultSequence>
         <property name="ERROR_MESSAGE" value="" type="STRING"/>
         <property name="TOOLS_ERROR" value="Error en API BPM al agregar rol a actor" type="STRING"/>
         <sequence key="toolsFault"/>
      </faultSequence>
   </resource>
</api>
                        
