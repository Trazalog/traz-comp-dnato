# ---------------------------------------------------------------------------
# traz-comp-dnato — configuración de Apache
#
# Este archivo es IGUAL EN TODOS LOS AMBIENTES y va versionado. No hay nada que
# descomentar, completar ni restaurar al desplegar: un `git pull` lo deja listo.
#
# La configuración que sí cambia por ambiente (la URL pública, el emisor OAuth,
# la ruta de las claves) NO vive acá. Se resuelve sola o se declara en
# application/config/constants.php, que ya es el archivo por ambiente:
#
#   · La URL pública se autodetecta del request, protocolo incluido
#     (application/config/config.php). Con ngrok o detrás de un proxy HTTPS
#     funciona sin configurar nada.
#   · El emisor OAuth ("iss" del JWT) sale de DNATO_OAUTH_ISSUER en
#     constants.php, y si está vacío se deriva de la URL pública.
#   · Las claves JWT se leen de application/config/keys/, que es donde el
#     instructivo indica generarlas (doc/identity/jwt-keys-setup.md).
#
# Las variables de entorno DNATO_PUBLIC_URL, DNATO_ISSUER, JWT_PRIVATE_KEY_PATH
# y JWT_PUBLIC_KEY_PATH siguen teniendo prioridad si un servidor ya las define
# en su VirtualHost. Es el lugar correcto para hacerlo cuando haga falta: no
# este archivo, que es compartido.
# ---------------------------------------------------------------------------

RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)$ index.php/$1 [L]

# Con PHP como CGI o FastCGI, Apache no le pasa el header Authorization a PHP y
# las llamadas con Bearer llegan sin token. Con mod_php sobra, pero no molesta.
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
